# Base URL of the backend API.
# Local:  http://localhost:4000
# Hosted: https://linkedin-profile-api.onrender.com
#
# NEXT_PUBLIC_ means this value is baked into the browser bundle, which is
# correct here: it is a public URL, not a secret. Never put the LinkedIn
# cookie or an API key in a NEXT_PUBLIC_ variable — the browser would expose
# it to anyone who opens devtools.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
