# ─── LinkedIn session ────────────────────────────────────────────────────────
# The WHOLE cookie header from a logged-in browser, on one line.
# `li_at` alone is not enough: without LinkedIn's routing and device cookies
# (lidc, bcookie, bscookie, ...) it answers with an endless redirect.
#
# How to get it: DevTools -> Network -> load a profile -> right-click the
# document request -> Copy as cURL -> take the value after -b or 'cookie:'.
# Full walkthrough in the README. NEVER commit the real value.
LINKEDIN_COOKIE=

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Serve the bundled sample profile instead of calling LinkedIn.
# Great for local development and for demoing without a session.
MOCK_MODE=true

# ─── Access control ──────────────────────────────────────────────────────────
# If set, callers must send it as `x-api-key` (or `Authorization: Bearer ...`).
# Leave blank to keep the API open.
API_KEY=

# Comma-separated browser origins allowed to call the API, or * for all.
CORS_ORIGINS=*

# ─── Behaviour ───────────────────────────────────────────────────────────────
# Cache each profile for this many seconds (0 disables caching).
CACHE_TTL_SECONDS=900

# Per-IP rate limit.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Wait this long before every call to LinkedIn. Keeps the account safe.
REQUEST_DELAY_MS=1200
